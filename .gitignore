# Credentials — never commit. See CLAUDE.md R7/R8.
.env
.env.*
*.pem
*.key
credentials
credentials.*
.aws/
.gcloud/
.config/gcloud/

# Build output.
#
# These are anchored with a leading slash on purpose. An unanchored
# "distbackup" matches at *any* depth, which silently excluded the entire
# cmd/distbackup/ source directory from the repository — it built fine
# locally, where the files exist on disk, and only failed on a fresh clone.
/bin/
/dist/
/distbackup

# Test artifacts and local repositories
*.test
*.out
coverage.*
/testdata/tmp/
*.distbackup-repo/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Agent / process files. Kept out of the public repo deliberately: they are
# working notes about how the project was planned and built, not part of the
# project itself. Local copies live in ../distbackup-private/.
CLAUDE.md
AGENT_PROMPTS.md
